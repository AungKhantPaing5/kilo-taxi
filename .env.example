ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
# Optional: can also be entered in Admin > Google Maps
GOOGLE_MAPS_API_KEY=

# Billing-free regional routing container
OSRM_URL=http://osrm:5000
# For high traffic, configure a production tile provider or own tile server
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
